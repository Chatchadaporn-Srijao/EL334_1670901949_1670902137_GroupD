#include "MK64F12.h" // Include the microcontroller header file
//**SECTION 1: CONSTANT DEFINITIONS**//
#define MASK(x) (1UL << (x)) // Create a bit mask by shifting 1 to bit position x
// - 7 segment pin definitions - //
#define LATCH_PIN 23 // Set PTB23 (D4) as the 7-segment LATCH pin
#define CLOCK_PIN 3 // Set PTC3 (D7) as the CLOCK pin for data transmission
#define DATA_PIN 12 // Set PTC12 (D8) as the DATA pin for data transmission
// - Switch pin definitions - //
#define S1_PIN 3 // Set PTB3 (A1) as S1 for starting, confirming, and restarting the game
#define SW2_PIN 10 // Set PTB10 (A2) as the tens-digit increment switch
#define SW3_PIN 11 // Set PTB11 (A3) as the units-digit increment switch
// - LED pin definitions - //
#define D1_PIN 1 // Set PTD1 (D13) as the LED when the answer is much higher
#define D2_PIN 3 // Set PTD3 (D12) as the LED when the answer is higher
#define D3_PIN 2 // Set PTD2 (D11) as the LED when the answer is lower
#define D4_PIN 0 // Set PTD0 (D10) as the LED when the answer is much lower
// - Buzzer pin definition - //
#define BUZZER_PIN 1 // Set PTA1 (D3) as the Buzzer control pin

//**SECTION 2: GLOBAL VARIABLE DECLARATIONS**//
// - Timer variables - //
volatile uint32_t msTicks = 0; // Millisecond counter updated by an interrupt; volatile is required
uint32_t lastTick = 0; // Store the last reference time for the one-second countdown
uint32_t countdownStartTime = 0; // Store the game start time to calculate elapsed time
// - Normal Buzzer status variables  – //
uint32_t buzzerStartTime = 0; // Store the start time of the alert
int buzzerActive = 0; // State of buzzer
int buzzerStage = 0; // Store the number of alerts already triggered
// - Timeout Buzzer status variables  – //
uint32_t timeoutBuzzerStartTime = 0; // Store the start time of the timeout alert
int timeoutBuzzerActive = 0; // state of timeout buzzer
// - Timer variables – //
int timerRunning = 0;  // Game timer is running

//**SECTION 3: FUNCTION DECLARATIONS**//
// - SysTick timer function – //
// Increment msTicks every millisecond to track system time
void SysTick_Handler(void) {
    msTicks++; // increase 1
}

// - Delay function – //
void delayMs(uint32_t n) {
    uint32_t start = msTicks; // Current time
    while ((uint32_t)(msTicks - start) < n); // Wait until the specified time has elapsed
}

// - Random number function – //
uint32_t randomSeed = 12345; // Set the seed for the pseudo-random number
unsigned char randomNumber(void) { // Generate and return a random number
    randomSeed = randomSeed * 1664525UL // Calculate a new seed
               + 1013904223UL + msTicks; // Add a constant and the current time to update the seed
    return (randomSeed >> 16) % 100; // Return value 0–99
}

// - Segment code 0 to 9 – //
const unsigned char SEGMENT_MAP[] = {
    0xC0, 0xF9, 0xA4, 0xB0, 0x99,
    0x92, 0x82, 0xF8, 0x80, 0x90
};

// - Digit selection code – //
const unsigned char SEGMENT_SELECT[] = {
    0xF1, 0xF2, 0xF4, 0xF8
};

// - Segment code FAIL– //
const unsigned char FAIL_MAP[] = {
    0x8E, 0x88, 0xF9, 0xC7
};

// - Segment code PASS – //
const unsigned char PASS_MAP[] = {
    0x8C, 0x88, 0x92, 0x92
};

// - LED off function – //
//Turn off all LEDs for the next hint
void LED_off(void) {
    PTD->PSOR = MASK(D1_PIN) | // HIGH to the GPIO pins
                	MASK(D2_PIN) |
                	MASK(D3_PIN) |
             	MASK(D4_PIN);
}

// - GPIO initialization function – //
// Config port for push buttons, 7-segment display, and LEDs
void GPIO_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTA_MASK |
                  SIM_SCGC5_PORTB_MASK |
                  SIM_SCGC5_PORTC_MASK |
                  SIM_SCGC5_PORTD_MASK; // Enable the clock for Port A B C D

    PORTA->PCR[BUZZER_PIN] = PORT_PCR_MUX(1); // Config Port A BUZZER_PIN as GPIO
  
    PORTB->PCR[LATCH_PIN] = PORT_PCR_MUX(1); // Config Port B LATCH_PIN as GPIO
    PORTC->PCR[CLOCK_PIN] = PORT_PCR_MUX(1); // Config Port C CLOCK_PIN as GPIO
    PORTC->PCR[DATA_PIN] = PORT_PCR_MUX(1); // Config Port C DATA_PIN as GPIO

    PORTB->PCR[S1_PIN] = PORT_PCR_MUX(1) | // Config Port B S1_PIN as GPIO
                         PORT_PCR_PE_MASK |
                         PORT_PCR_PS_MASK;

    PORTB->PCR[SW2_PIN] = PORT_PCR_MUX(1) | // Config Port B SW2_PIN as GPIO
                          PORT_PCR_PE_MASK |
                          PORT_PCR_PS_MASK;
    PORTB->PCR[SW3_PIN] = PORT_PCR_MUX(1) | // Config Port B SW3_PIN as GPIO
                          PORT_PCR_PE_MASK |
                          PORT_PCR_PS_MASK;

    PORTD->PCR[D1_PIN] = PORT_PCR_MUX(1); // Config Port D D1_PIN as GPIO
    PORTD->PCR[D2_PIN] = PORT_PCR_MUX(1); // Config Port D D2_PIN as GPIO
    PORTD->PCR[D3_PIN] = PORT_PCR_MUX(1); // Config Port D D3_PIN as GPIO
    PORTD->PCR[D4_PIN] = PORT_PCR_MUX(1); // Config Port D D4_PIN as GPIO

    PTA->PDDR &= ~MASK(BUZZER_PIN); // Set Port A BUZZER_PIN as input to turn off the Buzzer
    PTB->PDDR |= MASK(LATCH_PIN); // Set Port B LATCH_PIN as output
    PTB->PDDR &= ~(MASK(S1_PIN) | // Set Port B S1_PIN as input
                   MASK(SW2_PIN) | // Set Port B SW2_PIN as input
                   MASK(SW3_PIN)); // Set Port B SW3_PIN as input
    PTC->PDDR |= MASK(CLOCK_PIN) | // Set Port C CLOCK_PIN as output
                 MASK(DATA_PIN); // Set Port C DATA_PIN as output
    PTD->PDDR |= MASK(D1_PIN) | // Set Port D D1_PIN as output
                 MASK(D2_PIN) | // Set Port D D2_PIN as output
                 MASK(D3_PIN) | // Set Port D D3_PIN as output
                 MASK(D4_PIN); // Set Port D D4_PIN as output

    PTB->PCOR = MASK(LATCH_PIN); // Set Port B LATCH_PIN LOW
    PTC->PCOR = MASK(CLOCK_PIN) | // Set Port C CLOCK_PIN LOW
                MASK(DATA_PIN); // Set Port C DATA_PIN LOW
    LED_off();
}

// - Buzzer on function – //
void Buzzer_ON(void) {
    PTA->PCOR = MASK(BUZZER_PIN); // Set Port A BUZZER_PIN LOW
    PTA->PDDR |= MASK(BUZZER_PIN); // Set Port A BUZZER_PIN as output to turn on the Buzzer
}

// - Buzzer off function – //
void Buzzer_OFF(void) {
    PTA->PDDR &= ~MASK(BUZZER_PIN); // Set Port A BUZZER_PIN as input to turn off the Buzzer
}

// - Remaining time check function – //
void Buzzer_Update(void) {
    uint32_t currentTime = msTicks; // Read the current time from the SysTick counter
    uint32_t elapsedTime = // Store the elapsed time since the game started
        (uint32_t)(currentTime - countdownStartTime); // Calculate the elapsed time since the countdown started

    if (buzzerActive) {
        if ((uint32_t)(currentTime - buzzerStartTime) >= 200U) { // If 0.2 seconds have elapsed
            Buzzer_OFF();
            buzzerActive = 0; // Buzzer status is inactive
        }
    }
// Activate the Buzzer at 30, 20, 10, 3, 2, and 1 seconds
    if (!buzzerActive && buzzerStage < 6) { // If Buzzer is inactive < 6 alerts
        if ((buzzerStage == 0 && elapsedTime >= 30000U) || // If no alerts and 30 seconds left
            (buzzerStage == 1 && elapsedTime >= 40000U) || // If 1 alert and 20 seconds left
            (buzzerStage == 2 && elapsedTime >= 50000U) || // If 2 alerts and 10 seconds left
            (buzzerStage == 3 && elapsedTime >= 57000U) || // If 3 alerts and 3 seconds left
            (buzzerStage == 4 && elapsedTime >= 58000U) || // If 4 alerts and 2 seconds left
            (buzzerStage == 5 && elapsedTime >= 59000U)) { // If 5 alerts and 1 second left
            Buzzer_ON();
            buzzerActive = 1; //  Buzzer status is active
            buzzerStartTime = currentTime; // Current time as the alert start time
            buzzerStage++; // Increase 1
        }
    }
}

// - LED hint function – //
void LED_hint(int answer, int target) {
    int difference = answer - target; // Calculate the difference between the guess and the target number
    LED_off();
    if (difference >= 10) {
        PTD->PCOR = MASK(D1_PIN); // Set Port D D1_PIN LOW to turn on LED D1
    }
    else if (difference > 0) {
        PTD->PCOR = MASK(D2_PIN); // Set Port D D2_PIN LOW to turn on LED D2
    }
    else if (difference <= -10) {
        PTD->PCOR = MASK(D4_PIN); // Set Port D D4_PIN LOW to turn on LED D4
    }
    else if (difference < 0) {
        PTD->PCOR = MASK(D3_PIN); // Set Port D D3_PIN LOW to turn on LED D3
    }
}

// - Shiftout function – //
// Send 8 bit data serial to the 7-segment display
void shiftOut(unsigned char data) {
    int i;
    for (i = 7; i >= 0; i--) {
        if (data & MASK(i))
            PTC->PSOR = MASK(DATA_PIN); // Set Port C DATA_PIN HIGH
        else
            PTC->PCOR = MASK(DATA_PIN); // Set Port C DATA_PIN LOW
            PTC->PSOR = MASK(CLOCK_PIN); // Set Port C CLOCK_PIN HIGH
            PTC->PCOR = MASK(CLOCK_PIN); // Set Port C CLOCK_PIN LOW
    }
}

// - Write pattern digit function – //
// Display the specified segment pattern on the selected 7-segment digit
void writePatternDigit(unsigned char digitIndex,
                       unsigned char pattern) {
    PTB->PCOR = MASK(LATCH_PIN); // Set Port B LATCH_PIN LOW
    shiftOut(pattern);
    shiftOut(SEGMENT_SELECT[digitIndex]);
    PTB->PSOR = MASK(LATCH_PIN); // Set Port B LATCH_PIN HIGH
    delayMs(2);
}

// - Write digit function – //
// Display a digit from 0 to 9
void writeDigit(unsigned char digitIndex,
                unsigned char value) {
    writePatternDigit(digitIndex,
                      SEGMENT_MAP[value]);
}

// - Display number function – //
// Display a four-digit number on the 7-segment display
void displayNumber(unsigned char d0, // Receive the value for digit 1
                   unsigned char d1, // Receive the value for digit 2
                   unsigned char d2, // Receive the value for digit 3
                   unsigned char d3) { // Receive the value for digit 4
    writeDigit(0, d0); // display number for dugit 1
    writeDigit(1, d1); // display number for dugit 2
    writeDigit(2, d2); // display number for dugit 3
    writeDigit(3, d3); // display number for dugit 4
}

// - Display answer function – //
//Display the number of incorrect guesses (digits 1–2) and the number currently selected by the player (digits 3–4)
void displayAnswer(unsigned char wrongCount, // Incorrect guesses
                   unsigned char tens, // Tens digit
                   unsigned char units) { // Units digit
    writeDigit(0, wrongCount / 10);
    writeDigit(1, wrongCount % 10);
    writeDigit(2, tens);
    writeDigit(3, units);
}

// - Display FAIL function – //
void displayFail(void) {
    writePatternDigit(0, FAIL_MAP[0]); // uesing value from FAIL_MAP at index 0
    writePatternDigit(1, FAIL_MAP[1]); // uesing value from FAIL_MAP at index 1
    writePatternDigit(2, FAIL_MAP[2]); // uesing value from FAIL_MAP at index 2
    writePatternDigit(3, FAIL_MAP[3]); // uesing value from FAIL_MAP at index 3
}

// - Display PASS function – //
void displayPass(void) {
    writePatternDigit(0, PASS_MAP[0]); // uesing value from PASS_MAP at index 0
    writePatternDigit(1, PASS_MAP[1]); // uesing value from PASS_MAP at index 1
    writePatternDigit(2, PASS_MAP[2]); // uesing value from PASS_MAP at index 2
    writePatternDigit(3, PASS_MAP[3]); // uesing value from PASS_MAP at index 3
}

//**SECTION 4: MAIN PROGRAM**//
int main(void) {
    unsigned char tens = 0; // Store the tens digit
    unsigned char units = 0; // Store the units digit
    unsigned char randomValue = 0; // Store the generated random number
    unsigned char timer = 0; // Store the timer value
    unsigned char wrongCount = 0; // Store the incorrect guesses
    int gameStarted = 0; // Store the game started status
    int gameFinished = 0; // Store the game finished status
    int passed = 0; // Store the win status
    int s1Prev = 1; // Store the previous S1 button state
    int sw2Prev = 1; // Store the previous SW2 button state
    int sw3Prev = 1; // Store the previous SW3 button state
    int answer; // Store the guess

    GPIO_init(); // Call GPIO_init() to confige all GPIO pins

    SysTick_Config(SystemCoreClock / 1000U); // Config SysTick to generate an interrupt every 1 millisecond

    while (1) {
// Game display
        if (gameFinished) { // Game finished
            if (passed) // If win
                displayPass(); // Display PASS
            else // If loses
                displayFail(); // Display FAIL
        }
        else if (gameStarted) { // Game started
            displayAnswer(wrongCount, tens, units); // Display WrongCount Tens Units
        }
        else { // Game has not started
            displayNumber(0, 0, 0, 0); // Display 0000
        }

// S1 button
        if (!(PTB->PDIR & MASK(S1_PIN)) && s1Prev) { // When pressed the input is 0 // When released, the input is 1 because a pull-up resistor is used 
            delayMs(20); // Allow the signal to stabilize
            if (!(PTB->PDIR & MASK(S1_PIN))) { // Check again whether the button is pressed

	// S1 button: restart game state
                if (gameFinished) { // If game has finished
                    gameFinished = 0; 
                    gameStarted = 0;
                    passed = 0;
                    tens = 0;
                    units = 0;
                    wrongCount = 0;
                    timer = 0;
                    timerRunning = 0;
                    buzzerActive = 0;
                    buzzerStage = 0;
                    timeoutBuzzerActive = 0;

                    Buzzer_OFF();
                    LED_off();
                }
	
    // S1 button: start game state
                else if (!gameStarted) { // If game is starting
                    randomValue = randomNumber(); // Ramdom target number 0-99
                    timer = 60; // Set the game duration to 60 seconds
                    tens = 0;
                    units = 0;
                    wrongCount = 0;
                    gameStarted = 1;
                    timerRunning = 1; // Start the timer
                    buzzerActive = 0;
                    buzzerStage = 0;
                    timeoutBuzzerActive = 0;

                    Buzzer_OFF();
                    LED_off();

                    lastTick = msTicks; // Set the last countdown reference time to msTicks
                    countdownStartTime = msTicks; // Set the game start time to msTicks
                }

	// S1 button: confirm guess state
                else {
                    answer = tens * 10 + units; // Combine the tens and units digits to form a guess from 0 to 99
                    if (answer == randomValue) { // Correct answer
                        passed = 1; // Win
                        gameStarted = 0;
                        gameFinished = 1; // Game finished
                        timerRunning = 0;
                        buzzerActive = 0;
                        timeoutBuzzerActive = 0;

                        Buzzer_OFF();
                        LED_off();
                    }
                    else { // Incorrect answer
                        if (wrongCount < 99) {
                            wrongCount++; // Increase 1
                        }
                        LED_hint(answer, randomValue); // Display hint
                    }
                }
            }
            s1Prev = 0; // Prevent repeated readings while the button is held down
        }

// S1 button has been released
        if (PTB->PDIR & MASK(S1_PIN)) { // Input returns to 1
            s1Prev = 1; // Prepare for the next button check
        }

// SW3 button (units digit)
        if (!(PTB->PDIR & MASK(SW3_PIN)) && sw3Prev) { // When pressed the input is 0 // When released, the input is 1 because a pull-up resistor is used
            delayMs(20); // Allow the signal to stabilize
            if (!(PTB->PDIR & MASK(SW3_PIN)) && gameStarted) { // Button is pressed and the game has started
                units++; // Increase the units digit
                if (units > 9) {
                    units = 0;
                }
            }
            sw3Prev = 0; // Prevent repeated readings while the button is held down
        }

// SW3 button (units digit) has been released
        if (PTB->PDIR & MASK(SW3_PIN)) { // Input returns to 1
            sw3Prev = 1; // Prepare for the next button check
        }

// SW2 button (tens digit)
        if (!(PTB->PDIR & MASK(SW2_PIN)) && sw2Prev) {// When pressed the input is 0 // When released, the input is 1 because a pull-up resistor is used
            delayMs(20); // Allow the signal to stabilize
            if (!(PTB->PDIR & MASK(SW2_PIN)) && gameStarted) { // Button is pressed and the game has started
                tens++; // Increase the tens digit
                if (tens > 9) {
                    tens = 0;
                }
            }
            sw2Prev = 0; // Prevent repeated readings while the button is held down
        }
        
// SW2 button (tens digit) has been released
        if (PTB->PDIR & MASK(SW2_PIN)) { // Input returns to 1
            sw2Prev = 1; // Prepare for the next button check
        }

// 60-second countdown
        if (timerRunning) { // If the timer is running
            while ((uint32_t)(msTicks - lastTick) >= 1000U) { // When one second has elapsed
                lastTick += 1000U; // + 1
                if (timer > 0) { // If the remaining time is greater than 0
                    timer--; // - 1
                }

                if (timer == 0) { // If the time has expired
                    timerRunning = 0; // Stop the timer
                    gameStarted = 0;
                    gameFinished = 1; // Game has finished
                    passed = 0;
                    buzzerActive = 0;

                    Buzzer_ON();

                    timeoutBuzzerActive = 1; // Set the timeout Buzzer status to inactive

                    timeoutBuzzerStartTime = msTicks; // Store msTicks as the timeout alert start time

                    LED_off();
                    break; // Exit the loop
                }
            }

// Check the remaining time
            if (timerRunning) { //If the timer is running
                Buzzer_Update(); // Update alerts at the specified time intervals
            }
        }
        
// Check whether the timeout alert is active
        if (timeoutBuzzerActive) { // If the timeout alert is active
            if ((uint32_t)(msTicks - timeoutBuzzerStartTime) >= 1000U) { // Check whether the timeout alert has sounded for one second
                Buzzer_OFF();
                timeoutBuzzerActive = 0; // Set the timeout Buzzer status to inactive
            }
        }
    }
}
